@using LinguaFlow.Core.Assessment
@inject Microsoft.Extensions.Localization.IStringLocalizer<LinguaFlow.Web.Resources.Strings> T
<div class="exercise-feedback @Feedback.Status.ToString().ToLowerInvariant()" role="status">
    <strong>@T[State?.ToString() ?? Feedback.Status.ToString()]</strong>
    @if (Feedback.Status is GradingStatus.Correct or GradingStatus.Incorrect or GradingStatus.Partial) { <span class="feedback-score"> · @T["AutomaticScore"]: @Feedback.EarnedScore / @Feedback.MaximumScore</span> }
    else { <span class="feedback-score"> · @T["RubricReviewPending"]</span> }
    <p>@T[Feedback.Message]</p>
    @if (!string.IsNullOrWhiteSpace(Feedback.CorrectAnswer)) { <div class="feedback-reference"><strong>@T["AuthoredAnswer"]:</strong><SafeMarkdown Text="@Feedback.CorrectAnswer" /></div> }
    @if (!string.IsNullOrWhiteSpace(Feedback.Explanation)) { <div class="feedback-explanation"><strong>@T["Explanation"]</strong><SafeMarkdown Text="@Feedback.Explanation" /></div> }
</div>
@code {
    [Parameter, EditorRequired] public ExerciseFeedback Feedback { get; set; } = default!;
    [Parameter] public LinguaFlow.Web.Services.ExerciseUiState? State { get; set; }
}
